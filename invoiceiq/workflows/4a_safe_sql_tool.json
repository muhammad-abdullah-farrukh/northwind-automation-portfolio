{
  "name": "InvoiceIQ - 4a safe_sql tool",
  "nodes": [
    {
      "parameters": {
        "content": "## safe_sql\nThe agent's SQL tool. Two layers: this guard (one SELECT, no write keywords, LIMIT 50 added) and the database role `finance_agent` (read-only transactions, 5 s statement timeout, SELECT on `invoices` and `line_items` only).",
        "height": 150,
        "width": 620,
        "color": 7
      },
      "id": "b5afe930-9c47-4776-891f-98664e2fbccb",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -260
      ]
    },
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "sql",
              "type": "string"
            }
          ]
        }
      },
      "id": "963ba0f7-bfe1-400b-8479-3ae41482dc83",
      "name": "SQL from the agent",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "let sql = String($json.sql || '').trim().replace(/;+\\s*$/, '');\nconst lower = sql.toLowerCase();\nconst refuse = (why) => [{ json: { ok: false, error: why, sql } }];\nif (!sql) return refuse('empty query');\nif (sql.includes(';')) return refuse('only one statement is allowed');\nif (!/^(select|with)\\b/.test(lower)) return refuse('only SELECT queries are allowed');\nif (/\\b(insert|update|delete|merge|drop|alter|create|grant|revoke|truncate|copy|call|vacuum|lock|pg_sleep)\\b/.test(lower)) {\n  return refuse('the query contains a keyword that is not allowed');\n}\nif (!/\\blimit\\s+\\d+/.test(lower)) sql = `select * from (${sql}) as q limit 50`;\nreturn [{ json: { ok: true, sql } }];\n"
      },
      "id": "3fe1496c-acbe-40f0-b3be-3d83178c5233",
      "name": "Guard: one read-only SELECT",
      "type": "n8n-nodes-base.code",
