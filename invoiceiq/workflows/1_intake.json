        "options": {
          "waitForSubWorkflow": false
        }
      },
      "id": "ad49a133-f654-4f77-a849-a6aa4d2c0447",
      "name": "Process each invoice (email)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
