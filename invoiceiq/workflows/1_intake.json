      "maxTries": 5,
      "waitBetweenTries": 3000,
      "webhookId": "4581ee88-fa75-4570-8d3b-43c68e907400"
    },
    {
      "parameters": {
        "formTitle": "Submit a supplier invoice",
        "formDescription": "Northwind Digital accounts payable. Upload one or more PDF invoices; each one is checked and either filed automatically or sent to #finance-approvals for review.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Invoice PDF",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "Your email",
              "fieldType": "email",
              "placeholder": "so we can reach you about this invoice"
            }
          ]
        },
        "options": {
          "path": "invoiceiq-upload",
          "buttonLabel": "Submit invoice",
          "appendAttribution": false
        }
      },
      "id": "5c37114f-4fb1-4f55-bf75-4751a621e4ac",
      "name": "Invoice upload form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.3,
      "position": [
        0,
        240
      ],
      "webhookId": "ab6ee916-cec8-4251-9ac3-8adcd68f70c0"
    },
    {
      "parameters": {
        "jsCode": "// One item per uploaded PDF.\nconst out = [];\nfor (const item of $input.all()) {\n  const f = item.json;\n  for (const [key, bin] of Object.entries(item.binary || {})) {\n    const name = bin.fileName || key;\n    if (bin.mimeType !== 'application/pdf' && !/\\.pdf$/i.test(name)) continue;\n    out.push({\n      json: {\n        source: 'form', source_ref: $execution.id, source_email: f['Your email'] || '', subject: '', file_name: name,\n        received_at: f.submittedAt ? new Date(f.submittedAt).toISOString() : new Date().toISOString(),\n      },\n      binary: { file: bin },\n    });\n  }\n}\nreturn out;\n"
      },
