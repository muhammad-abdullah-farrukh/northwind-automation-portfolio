# Copy to .env and fill in. .env is git-ignored; never commit real values.
POSTGRES_USER=opscore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opscore

# LLM provider: anthropic | openai_compat | none
#  - Anthropic API:             LLM_PROVIDER=anthropic, LLM_BASE_URL empty
#  - Anthropic-compatible gateway (e.g. AgentRouter): LLM_PROVIDER=anthropic, LLM_BASE_URL=https://agentrouter.org
#  - Ollama (local, free):      LLM_PROVIDER=openai_compat, LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_EXTRACT=
# tool | structured | prompt  (tool = forced tool_use, most portable across gateways)
LLM_JSON_MODE=tool
LLM_TIMEOUT_S=4.0

# Total time budget for /v1/leads/enrich (seconds)
ENRICH_BUDGET_S=4.8

# Async jobs + signed callbacks (DECISIONS D24-D26)
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_S=10
CALLBACK_HMAC_SECRET=          # long random string; the same value goes into the receiver (n8n Crypto credential)
CALLBACK_HOST_MAP=localhost:5678->host.docker.internal
CALLBACK_CA_FILE=/app/certs/n8n-cert.pem   # copy of n8n's PUBLIC cert (never its key)

# InvoiceIQ finance schema logins (invoiceiq/sql/001_finance_schema.sql)
FINANCE_WRITER_PASSWORD=
FINANCE_AGENT_PASSWORD=
